---
import { getCollection } from 'astro:content';
import PostCard from '../PostCard.astro';

const blogs = (await getCollection('blogs'))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 6);
---
<div class="content content-wide">
  <div class="section-header">
    <h1>Latest Blog Posts</h1>
    <p>
      All reviews, books and otherwise, my culinary achievements, random thoughts and more from all over this journal XD 
    </p>
  </div>
  <div class="max-w-sm mx-auto md:max-w-none mt-6">
    <div class="grid gap-12 grid-cols-vertical-cards items-start">
      {blogs.map((entry) => <PostCard entry={entry} />)}
    </div>
  </div>
</div>
